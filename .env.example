# Copy this file to .env and fill in any optional keys you want to enable.
# Core Rule: Agents only suggest. Humans decide and trade manually.
# All price bars and market data use real historical market feeds (Yahoo Finance by default).
# Offline synthetic/demo price generation is disabled.

# Optional LLM API keys for [2. Research (AI)], [5. Report (AI)], and [6. Monitor] summaries.
# Leave empty to use built-in deterministic synthesis and keyword event flagging.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-latest

# Optional read-only Alpaca market news keys (used only to enrich headline feeds; NEVER places orders).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Optional phone/chat alerts from [6. Monitor Agent] when health issues or stop alerts occur.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
